
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "hostname": "127.0.0.1",
      "log": false
    },
    {
      "name": "Debug current PHP file",
      "type": "php",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "port": 9003,
      "runtimeExecutable": "/usr/bin/php",
      "env": {
        "XDEBUG_TRIGGER": "1"
      }
    }
  ]
}
